{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "true",
  "buildCommand": "mkdir -p public",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": { "maxDuration": 300, "memory": 2048 }
  },
  "regions": ["bom1"],
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index.py" }]
}
