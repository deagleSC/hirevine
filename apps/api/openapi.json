              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Org Id"
          },
          "org_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Org Name"
          },
          "role": {
            "enum": [
              "manager",
              "candidate"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "role",
          "display_name"
        ],
        "title": "Me",
        "type": "object"
      },
      "Organization": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "Organization",
        "type": "object"
      },
      "ProfileCreate": {
        "properties": {
          "adult_confirmed": {
            "default": false,
            "title": "Adult Confirmed",
            "type": "boolean"
          },
          "display_name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "org_name": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Org Name"
          },
          "role": {
            "enum": [
              "manager",
              "candidate"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role",
          "display_name"
        ],
        "title": "ProfileCreate",
        "type": "object"
      },
