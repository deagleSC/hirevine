APP_ENV=dev
# Local: hirevine_api on the local dev DB. Production: Supavisor transaction-mode URL (port 6543),
# user hirevine_api.<project-ref>
DATABASE_URL=postgresql://hirevine_api:dev@localhost:5432/hirevine_dev
# Asymmetric signing keys: set SUPABASE_URL (JWKS). Legacy projects: also set SUPABASE_JWT_SECRET.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUD=authenticated
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
CRON_SECRET=

# LLM (OpenRouter). Model lists are ordered; OpenRouter falls back down the list.
OPENROUTER_API_KEY=
# LLM_STRUCTURED_MODELS=["google/gemma-4-31b-it","nvidia/nemotron-3-ultra-550b-a55b"]
# LLM_BULK_MODELS=["google/gemma-4-26b-a4b-it"]
LLM_PILOT_MODE=false
# LLM_PILOT_ALLOWLIST=["google/gemma-4-31b-it:free"]
LLM_DAILY_CAP=50
LLM_RPM_CAP=20
LLM_SYNC_RPM_CAP=2

# Tracing (optional; off unless both keys are set)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Inngest. Not needed locally: dev/test talk to the dev server (`pnpm --filter @hirevine/api dev:jobs`).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Resume storage (Supabase Storage, private bucket `resumes`). The service key is used ONLY for
# signed upload URLs and downloads, never for the database. Unset in dev/test: in-memory store.
SUPABASE_SERVICE_KEY=
RESUME_BUCKET=resumes

# Embeddings Edge Function (supabase/functions/embed). Unset in dev/test: a hashing embedder.
EMBED_FUNCTION_URL=
EMBED_FUNCTION_KEY=

# Bump when the consent text in the candidate app changes.
CONSENT_TEXT_VERSION=2026-11-10
APPLICATIONS_PER_DAY=10
UPLOAD_URLS_PER_HOUR=20
